// Fresh Store — shared database schema
// One database, consumed by: user mobile app, user website, admin mobile app, admin website
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Users & Auth ----------

enum Role {
  CUSTOMER
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(uuid())
  phone        String   @unique // E.164 format, e.g. +9198xxxxxxx
  name         String?
  email        String?
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses    Address[]
  cartItems    CartItem[]
  wishlist     WishlistItem[]
  orders       Order[]
  otps         OtpRequest[]
  notifications Notification[]
  pushTokens   PushToken[]
}

// Expo push token registered by the customer or admin mobile app.
// A user can have multiple tokens (e.g. logged in on two devices).
model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  platform  String   // "ios" | "android"
  createdAt DateTime @default(now())
}

// OTP requests are stored server-side only; the code is hashed, never logged in plaintext
model OtpRequest {
  id          String   @id @default(uuid())
  phone       String
  codeHash    String
  purpose     String   // "LOGIN" | "ADMIN_LOGIN"
  expiresAt   DateTime
  consumed    Boolean  @default(false)
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])

  @@index([phone, purpose])
}

// ---------- Catalog ----------

model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  imageUrl  String?
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  products  Product[]
  createdAt DateTime   @default(now())
}

model Product {
  id            String       @id @default(uuid())
  name          String
  slug          String       @unique
  description   String?
  unit          String       // e.g. "1 kg", "500 ml", "1 pc"
  mrp           Decimal      @db.Decimal(10, 2)
  sellingPrice  Decimal      @db.Decimal(10, 2)
  discountPct   Decimal?     @db.Decimal(5, 2)
  imageUrl      String?
  images        String[]     @default([])
  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id])
  stockQty      Int          @default(0)
  lowStockAlert Int          @default(10)
  isActive      Boolean      @default(true)
  tags          String[]     @default([])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  cartItems     CartItem[]
  wishlist      WishlistItem[]
  orderItems    OrderItem[]

  @@index([categoryId])
  @@index([name])
}

// ---------- Cart / Wishlist ----------

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ---------- Addresses ----------

model Address {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  label        String   // "Home", "Work", etc.
  line1        String
  line2        String?
  landmark     String?
  city         String
  state        String
  pincode      String
  latitude     Float?
  longitude    Float?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  orders       Order[]
}

// ---------- Coupons ----------

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  description   String?
  discountType  String    // "PERCENT" | "FLAT"
  discountValue Decimal   @db.Decimal(10, 2)
  minOrderValue Decimal?  @db.Decimal(10, 2)
  maxDiscount   Decimal?  @db.Decimal(10, 2)
  usageLimit    Int?
  usedCount     Int       @default(0)
  isActive      Boolean   @default(true)
  validFrom     DateTime  @default(now())
  validTill     DateTime?
  orders        Order[]
}

// ---------- Orders ----------

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique // human-readable, e.g. FS-20260819-0001
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  addressId       String
  address         Address       @relation(fields: [addressId], references: [id])
  items           OrderItem[]

  subtotal        Decimal       @db.Decimal(10, 2)
  discount        Decimal       @db.Decimal(10, 2) @default(0)
  deliveryFee     Decimal       @db.Decimal(10, 2) @default(0)
  total           Decimal       @db.Decimal(10, 2)

  couponId        String?
  coupon          Coupon?       @relation(fields: [couponId], references: [id])

  status          OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus   PaymentStatus @default(CREATED)

  razorpayOrderId   String?     @unique
  razorpayPaymentId String?
  razorpaySignature String?

  placedAt        DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?

  statusHistory   OrderStatusEvent[]
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id])
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  name       String  // snapshot at time of order
  unit       String
  price      Decimal @db.Decimal(10, 2) // snapshot price
  quantity   Int
}

model OrderStatusEvent {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
  changedBy String?     // admin user id, or "SYSTEM"
}

// ---------- Notifications ----------

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  channel   String   // "SMS" | "EMAIL" | "PUSH"
  title     String
  body      String
  status    String   @default("SENT") // SENT | FAILED
  createdAt DateTime @default(now())
}
